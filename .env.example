# Canonical environment reference. Copy this file to backend/.env for the API.
# Process environment overrides this file. Relative paths resolve under backend/.
# No frontend source or build is required to run python run.py.
# PostgreSQL database must already exist; ile-iwe creates its tables on startup.
# For local SQLite instead: DATABASE_URL=sqlite:///./ile-iwe.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ile_iwe
AUTO_MIGRATE=true
APP_NAME=ile-iwe
APP_ENV=development
JWT_SECRET_KEY=local-development-only-replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
TEMPORARY_PASSWORD_EXPIRE_HOURS=48
FRONTEND_URL=http://127.0.0.1:5173
CORS_ORIGINS=http://127.0.0.1:5173
PORT=8000
FORWARDED_ALLOW_IPS=127.0.0.1
ALLOW_SCHOOL_REGISTRATION=true
REQUIRE_SCHOOL_APPROVAL=false
LOCAL_STORAGE_PATH=./storage
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@localhost
SMTP_FROM_NAME=ile-iwe
SMTP_USE_TLS=true
LOG_LEVEL=INFO

# Optional backend Docker Compose: docker compose up -d --build (from backend/).
# Compose connects to its database service independently of the local DATABASE_URL.
POSTGRES_DB=ile_iwe
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-postgres-password
# COMPOSE_PROJECT_NAME=ile-iwe

# Frontend build/dev configuration (PUBLIC; set in frontend/.env or host environment).
# Do not copy backend/.env into frontend/.env; create only this public setting there.
# VITE_API_URL=http://127.0.0.1:8000/api/v1

# Optional verification settings: exported in the shell that runs the tests.
# These are not application settings and are intentionally not loaded from .env.
# Pytest defaults to a temporary SQLite database with simulated providers.
# ILE_TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/ile_iwe_test
# WARNING: pytest clears application tables in ILE_TEST_DATABASE_URL; use disposable data.
# E2E_FRONTEND_URL=http://127.0.0.1:5173
# E2E_API_URL=http://127.0.0.1:8003/api/v1
# E2E_STORAGE_PATH=C:\path\to\private\test-storage
# E2E_BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Browser tests call the API configured by the frontend's VITE_API_URL and create records.
# Portal tests also require E2E_API_URL to match that API, a running mail worker,
# and E2E_STORAGE_PATH pointing to its private simulated-email storage directory.
# See ../docs/VERIFICATION.md for isolation and reproduction instructions.
